{
  "name": "expert-system-rules",
  "version": "0.1.0",
  "private": true,
  "description": "Expert system rule sets in YAML, with an engine and a runner that tests rule-based reasoning against AI models",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "lint": "oxlint",
    "check": "node src/cli.ts check",
    "explain": "node src/cli.ts explain",
    "query": "node src/cli.ts query",
    "prompt": "node src/cli.ts prompt",
    "bench": "node src/cli.ts bench",
    "bench-extract": "node src/cli.ts bench-extract",
    "draft": "node src/cli.ts draft",
    "import-proofwriter": "node src/cli.ts import-proofwriter"
  },
  "dependencies": {
    "@x-tech-laboratories/x-libs": "^0.79.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.4",
    "@vitest/coverage-v8": "^5.1.2",
    "oxlint": "^1.95.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
